{
  "name": "pulso",
  "version": "0.1.0",
  "private": true,
  "description": "Pulso — landing SaaS de gestión de proyectos (Vite + React + TypeScript + Tailwind, hero 3D)",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
